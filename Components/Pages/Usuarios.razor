@page "/usuarios"

@using ProyectoBlazor.Models
@using ProyectoBlazor.Services
@using ProyectoBlazor.Shared

@rendermode InteractiveServer

@inject UsuarioService UsuarioService

<PageTitle>Administración de usuarios</PageTitle>

<div class="container mt-4">

    <div class="mb-4">

        <h2>Administración de usuarios</h2>

        <p class="text-muted mb-0">
            Consultá y administrá los usuarios registrados en StudyFlow.
        </p>

    </div>


    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @claseMensaje alert-dismissible fade show"
             role="alert">

            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="LimpiarMensaje">
            </button>

        </div>
    }


    @if (cargando)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>

            <p class="text-muted mt-2">
                Cargando usuarios...
            </p>

        </div>
    }
    else if (usuarios.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no hay usuarios registrados.
        </div>
    }
    else
    {
        <div class="row">

            <!-- ====================================================== -->
            <!-- DATAGRID (VISTA PRINCIPAL) -->
            <!-- ====================================================== -->

            <div class="@(usuarioSeleccionado is null ? "col-12" : "col-lg-8")">

                <div class="usuarios-grid-container card shadow-sm mb-4">

                    <div class="card-body p-0">

                        <!-- CABECERA -->

                        <div class="usuarios-grid-header">

                            <div>

                                <h5 class="usuarios-grid-title">
                                    Usuarios actualmente registrados en StudyFlow
                                </h5>

                                <span class="usuarios-grid-subtitle">
                                    Seleccioná un usuario para verlo, editarlo o eliminarlo.
                                </span>

                            </div>

                            <div class="usuarios-grid-stats">

                                <span class="usuarios-count">
                                    @usuarios.Count
                                </span>

                                <span class="usuarios-count-label">
                                    @(usuarios.Count == 1
                                        ? "usuario"
                                        : "usuarios")
                                </span>

                            </div>

                        </div>


                        <!-- TOOLBAR -->

                        <div class="usuarios-grid-toolbar">

                            <div class="usuarios-search">

                                <RadzenIcon Icon="search" />

                                <input type="text"
                                       class="form-control"
                                       placeholder="Buscar por nombre o email..."
                                       @bind="textoBusqueda"
                                       @bind:event="oninput" />

                            </div>


                            <div class="usuarios-toolbar-actions">

                                <button type="button"
                                        class="btn btn-outline-primary"
                                        @onclick="AlternarFiltros">

                                    <RadzenIcon Icon="filter_alt" />

                                    @(mostrarFiltros
                                        ? "Ocultar filtros"
                                        : "Mostrar filtros")

                                </button>


                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="LimpiarBusqueda">

                                    <RadzenIcon Icon="clear" />

                                    Limpiar

                                </button>

                            </div>

                        </div>


                        <!-- DATAGRID -->

                        <RadzenDataGrid @ref="usuariosGrid"
                                        Data="@usuariosFiltrados"
                                        TItem="Usuario"
                                        AllowSorting="true"
                                        AllowPaging="true"
                                        PageSize="10"
                                        PageSizeOptions="@(new int[] { 5, 10, 20, 50 })"
                                        AllowFiltering="@mostrarFiltros"
                                        FilterMode="FilterMode.Simple"
                                        AllowAlternatingRows="true"
                                        AllowColumnResize="true"
                                        GridLines="DataGridGridLines.Horizontal"
                                        ShowPagingSummary="true"
                                        PagingSummaryFormat="Mostrando {0} a {1} de {2} usuarios">

                            <Columns>

                                <RadzenDataGridColumn TItem="Usuario"
                                                      Property="@nameof(Usuario.IdUsuario)"
                                                      Title="ID"
                                                      Width="80px" />

                                <RadzenDataGridColumn TItem="Usuario"
                                                      Property="@nameof(Usuario.Nombre)"
                                                      Title="Nombre"
                                                      Width="180px" />

                                <RadzenDataGridColumn TItem="Usuario"
                                                      Property="@nameof(Usuario.Email)"
                                                      Title="Email"
                                                      Width="260px" />

                                <RadzenDataGridColumn TItem="Usuario"
                                                      Property="@nameof(Usuario.FechaNacimiento)"
                                                      Title="Fecha de nacimiento"
                                                      FormatString="{0:dd/MM/yyyy}"
                                                      Width="170px" />

                                <RadzenDataGridColumn TItem="Usuario"
                                                      Property="@nameof(Usuario.FechaRegistro)"
                                                      Title="Fecha de registro"
                                                      FormatString="{0:dd/MM/yyyy HH:mm}"
                                                      Width="190px" />

                                <RadzenDataGridColumn TItem="Usuario"
                                                      Title="Acciones"
                                                      Width="140px"
                                                      Sortable="false"
                                                      Filterable="false">

                                    <Template Context="usuario">

                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                @onclick="() => SeleccionarUsuario(usuario)">

                                            Ver / Editar

                                        </button>

                                    </Template>

                                </RadzenDataGridColumn>

                            </Columns>

                        </RadzenDataGrid>

                    </div>

                </div>

            </div>


            <!-- ====================================================== -->
            <!-- DETALLE DEL USUARIO SELECCIONADO -->
            <!-- ====================================================== -->

            @if (usuarioSeleccionado is not null)
            {
                <div class="col-lg-4 mb-4">

                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <h5 class="mb-0">
                            Detalle del usuario
                        </h5>

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                @onclick="CerrarDetalle">

                            Cerrar

                        </button>

                    </div>


                    <UsuarioCard @key="usuarioSeleccionado.IdUsuario"
                                 Usuario="usuarioSeleccionado"
                                 OnGuardarEdicion="GuardarEdicion"
                                 OnEliminar="EliminarUsuario" />

                </div>
            }

        </div>
    }

</div>


@code {

    // ==========================================
    // LISTA DE USUARIOS
    // ==========================================

    private List<Usuario> usuarios = new();

    private Usuario? usuarioSeleccionado;


    // ==========================================
    // BÚSQUEDA Y FILTROS
    // ==========================================

    private string textoBusqueda = string.Empty;

    private bool mostrarFiltros = false;

    private RadzenDataGrid<Usuario>? usuariosGrid;

    private IEnumerable<Usuario> usuariosFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? usuarios
            : usuarios.Where(u =>
                u.Nombre.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase)
                ||
                u.Email.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase));


    // ==========================================
    // ESTADOS
    // ==========================================

    private bool cargando = true;

    private string mensaje = string.Empty;

    private string claseMensaje = "alert-info";


    // ==========================================
    // INICIALIZACIÓN
    // ==========================================

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }


    // ==========================================
    // CARGAR USUARIOS
    // ==========================================

    private async Task CargarUsuarios(bool mostrarCargando = true)
    {
        if (mostrarCargando)
        {
            cargando = true;
        }

        try
        {
            usuarios = await UsuarioService.ObtenerUsuariosAsync();
        }
        finally
        {
            cargando = false;
        }
    }


    // ==========================================
    // SELECCIÓN DE USUARIO
    // ==========================================

    private void SeleccionarUsuario(Usuario usuario)
    {
        LimpiarMensaje();

        usuarioSeleccionado = usuario;
    }

    private void CerrarDetalle()
    {
        usuarioSeleccionado = null;
    }


    // ==========================================
    // BÚSQUEDA Y FILTROS
    // ==========================================

    private void AlternarFiltros()
    {
        mostrarFiltros = !mostrarFiltros;
    }

    private async Task LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;

        if (usuariosGrid != null)
        {
            foreach (var columna in usuariosGrid.ColumnsCollection)
            {
                await usuariosGrid.ClearFilter(
                    columna,
                    closePopup: true,
                    shouldReload: false);
            }

            await usuariosGrid.Reload();
        }
    }


    // ==========================================
    // GUARDAR EDICIÓN
    // ==========================================

    private async Task GuardarEdicion(Usuario usuario)
    {
        LimpiarMensaje();

        int idUsuario = usuario.IdUsuario;

        bool actualizado = await UsuarioService.ActualizarUsuarioAsync(
            usuario.IdUsuario,
            usuario.Nombre,
            usuario.Email,
            usuario.FechaNacimiento
        );

        // Recargamos siempre: si la actualización falló,
        // así se descartan los cambios mutados en memoria.
        await CargarUsuarios(mostrarCargando: false);

        usuarioSeleccionado = usuarios
            .FirstOrDefault(u => u.IdUsuario == idUsuario);

        if (!actualizado)
        {
            mensaje = "No se pudo actualizar el usuario. Es posible que el correo electrónico ya esté registrado o que el usuario no exista.";

            claseMensaje = "alert-danger";

            return;
        }

        mensaje = "Los datos del usuario se actualizaron correctamente.";

        claseMensaje = "alert-success";
    }


    // ==========================================
    // ELIMINAR USUARIO
    // ==========================================

    private async Task EliminarUsuario(Usuario usuario)
    {
        LimpiarMensaje();

        bool eliminado =
            await UsuarioService.EliminarUsuarioAsync(
                usuario.IdUsuario);

        if (!eliminado)
        {
            mensaje = "No se pudo eliminar el usuario.";

            claseMensaje = "alert-danger";

            return;
        }

        usuarioSeleccionado = null;

        mensaje = "Usuario eliminado correctamente.";

        claseMensaje = "alert-success";

        await CargarUsuarios(mostrarCargando: false);
    }


    // ==========================================
    // LIMPIAR MENSAJE
    // ==========================================

    private void LimpiarMensaje()
    {
        mensaje = string.Empty;
    }

}

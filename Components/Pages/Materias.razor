@page "/materias"

@using ProyectoBlazor.Models
@using ProyectoBlazor.Services
@using ProyectoBlazor.Shared

@inject MateriaService MateriaService
@inject UsuarioActualService UsuarioActualService

@rendermode InteractiveServer

<PageTitle>Materias</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Mis Materias</h2>

            <p class="text-muted">
                Organizá tus materias y asociá tus tareas a cada una.
            </p> <br>
            <h3>
    Usuario actual: @UsuarioActualService.UsuarioId </h3>

        </div>

    </div>


    <!-- ============================ -->
    <!-- CREAR MATERIA -->
    <!-- ============================ -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">
                Nueva materia
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-5 mb-3">

                    <label class="form-label">
                        Nombre
                    </label>

                    <input class="form-control"
                           @bind="nombre"
                           placeholder="Ej: Programación" />

                </div>


                <div class="col-md-7 mb-3">

                    <label class="form-label">
                        Descripción
                    </label>

                    <input class="form-control"
                           @bind="descripcion"
                           placeholder="Descripción de la materia" />

                </div>


                <div class="mb-3">

                    <label for="color" class="form-label">
                        Color
                    </label>

                    <input id="color"
                           type="color"
                           class="form-control form-control-color"
                           @bind="color"
                           title="Elegí un color" />

                </div>

            </div>


            <button class="btn btn-primary"
                    @onclick="CrearMateria"
                    disabled="@guardando">

                @if (guardando)
                {
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Agregar materia</span>
                }

            </button>


            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-info mt-3 mb-0">
                    @mensaje
                </div>
            }

        </div>

    </div>


    <!-- ============================ -->
    <!-- LISTADO -->
    <!-- ============================ -->

    <div class="mb-3">

        <h4>
            Mis materias
        </h4>

    </div>


    @if (cargando)
    {
        <div class="text-center mt-4">

            <div class="spinner-border" role="status">

                <span class="visually-hidden">
                    Cargando...
                </span>

            </div>

            <p class="text-muted mt-2">
                Cargando materias...
            </p>

        </div>
    }
    else if (materias.Count == 0)
    {
        <div class="alert alert-secondary">
            Todavía no tenés materias registradas.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var materia in materias)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <MateriaCard
                        Materia="materia"
                        OnGuardarEdicion="GuardarEdicion"
                        OnEliminar="EliminarMateria" />

                </div>
            }

        </div>
    }

</div>


@code {

    // ==========================================
    // LISTADO
    // ==========================================

    private List<Materia> materias = new();


    // ==========================================
    // CREAR
    // ==========================================

    private string nombre = string.Empty;

    private string descripcion = string.Empty;

    private string color = "#0d6efd";

    private string mensaje = string.Empty;

    private bool guardando = false;


    // ==========================================
    // CARGA
    // ==========================================

    private bool cargando = true;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            bool usuarioRecuperado =
                await UsuarioActualService.CargarUsuarioAsync();

            if (usuarioRecuperado)
            {
                await CargarMaterias();
            }
            else
            {
                cargando = false;
            }

            StateHasChanged();
        }
    }


    private async Task CargarMaterias()
    {
        cargando = true;

        if (!UsuarioActualService.HayUsuarioSeleccionado())
        {
            materias = new List<Materia>();
            cargando = false;
            return;
        }

        try
        {
            materias =
                await MateriaService.ObtenerMateriasAsync(
                    UsuarioActualService.UsuarioId);
        }
        finally
        {
            cargando = false;
        }
    }


    // ==========================================
    // CREAR MATERIA
    // ==========================================

    private async Task CrearMateria()
    {
        if (guardando)
            return;

        if (!UsuarioActualService.HayUsuarioSeleccionado())
        {
            mensaje = "No hay un usuario activo.";
            return;
        }

        if (UsuarioActualService.UsuarioId <= 0)
        {
            mensaje = "El usuario activo no es válido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nombre))
        {
            mensaje = "El nombre de la materia es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(descripcion))
        {
            mensaje = "La descripción es obligatoria.";
            return;
        }

        guardando = true;
        mensaje = string.Empty;

        try
        {
            await MateriaService.CrearMateriaAsync(
                nombre.Trim(),
                descripcion.Trim(),
                color.Trim(),
                UsuarioActualService.UsuarioId);

            nombre = string.Empty;
            descripcion = string.Empty;
            color = "#0d6efd";

            mensaje = "Materia creada correctamente.";

            await CargarMaterias();
        }
        finally
        {
            guardando = false;
        }
    }


    // ==========================================
    // GUARDAR EDICIÓN
    // ==========================================

    private async Task GuardarEdicion(Materia materia)
    {
        if (!UsuarioActualService.HayUsuarioSeleccionado())
            return;

        bool actualizado =
            await MateriaService.ActualizarMateriaAsync(
                materia.IdMateria,
                materia.Nombre,
                materia.Descripcion,
                materia.Color,
                UsuarioActualService.UsuarioId);

        if (actualizado)
        {
            await CargarMaterias();
        }
    }


    // ==========================================
    // ELIMINAR
    // ==========================================

    private async Task EliminarMateria(Materia materia)
    {
        await MateriaService.EliminarMateriaAsync(
            materia.IdMateria,
            UsuarioActualService.UsuarioId);

        await CargarMaterias();

        mensaje = "Materia eliminada correctamente.";
    }

}
@page "/materias"

@using ProyectoBlazor.Models
@using ProyectoBlazor.Services

@inject MateriaService MateriaService

@rendermode InteractiveServer

<PageTitle>Materias</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Mis Materias</h2>
            <p class="text-muted">
                Organizá tus materias y asociá tus tareas a cada una.
            </p>
        </div>
    </div>

    <!-- Crear materia -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Nueva materia</h5>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-5 mb-3">
                    <label class="form-label">
                        Nombre
                    </label>

                    <input class="form-control"
                        @bind="nombre"
                        placeholder="Ej: Programación" />
                </div>

                <div class="col-md-7 mb-3">
                    <label class="form-label">
                        Descripción
                    </label>

                    <input class="form-control"
                        @bind="descripcion"
                        placeholder="Descripción de la materia" />
                </div>

            </div>

            <button class="btn btn-primary"
                    @onclick="CrearMateria"
                    disabled="@guardando">

                @if (guardando)
                {
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Agregar materia</span>
                }

            </button>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-info mt-3 mb-0">
                    @mensaje
                </div>
            }

        </div>
    </div>


    <!-- Listado de materias -->
    <div class="mb-3">
        <h4>Mis materias</h4>
    </div>

    @if (cargando)
    {
        <div class="text-center mt-4">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">
                    Cargando...
                </span>
            </div>

            <p class="text-muted mt-2">
                Cargando materias...
            </p>
        </div>
    }
    else if (materias.Count == 0)
    {
        <div class="alert alert-secondary">
            Todavía no tenés materias registradas.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var materia in materias)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card shadow-sm h-100">

                        @if (materiaEnEdicion == materia.IdMateria)
                        {
                            <!-- MODO EDICIÓN -->

                            <div class="card-body">

                                <h5 class="card-title mb-3">
                                    Editar materia
                                </h5>

                                <div class="mb-3">

                                    <label class="form-label">
                                        Nombre
                                    </label>

                                    <input class="form-control"
                                        @bind="nombreEdicion" />

                                </div>

                                <div class="mb-3">

                                    <label class="form-label">
                                        Descripción
                                    </label>

                                    <textarea class="form-control"
                                            rows="3"
                                            @bind="descripcionEdicion">
                                    </textarea>

                                </div>

                                <div class="d-flex gap-2">

                                    <button class="btn btn-success"
                                            @onclick="GuardarEdicion"
                                            disabled="@guardandoEdicion">

                                        @(guardandoEdicion
                                            ? "Guardando..."
                                            : "Guardar")

                                    </button>

                                    <button class="btn btn-secondary"
                                            @onclick="CancelarEdicion"
                                            disabled="@guardandoEdicion">

                                        Cancelar

                                    </button>

                                </div>

                            </div>
                        }
                        else
                        {
                            <!-- MODO VISUALIZACIÓN -->

                            <div class="card-body d-flex flex-column">

                                <h5 class="card-title">
                                    @materia.Nombre
                                </h5>

                                @if (!string.IsNullOrWhiteSpace(materia.Descripcion))
                                {
                                    <p class="card-text text-muted">
                                        @materia.Descripcion
                                    </p>
                                }
                                else
                                {
                                    <p class="card-text text-muted">
                                        Sin descripción.
                                    </p>
                                }

                                <div class="mt-auto pt-3">

                                    @if (materiaAEliminar == materia.IdMateria)
                                    {
                                        <div class="alert alert-warning py-3 mb-3">
                                            <small>
                                                ¿Seguro que querés eliminar esta materia?
                                            </small>
                                        </div>

                                        <div class="d-flex gap-2">

                                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarMateria(materia.IdMateria)"
                                                    disabled="@eliminando">

                                                @(eliminando ? "Eliminando..." : "Sí, eliminar")

                                            </button>

                                            <button class="btn btn-secondary btn-sm" @onclick="CancelarEliminacion"
                                                    disabled="@eliminando">

                                                Cancelar

                                            </button>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex gap-2">

                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => IniciarEdicion(materia)">

                                                Editar

                                            </button>

                                            <button class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => ConfirmarEliminacion(materia.IdMateria)">

                                                Eliminar

                                            </button>

                                        </div>
                                    }

                                </div>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>


@code {

    private List<Materia> materias = new();

    // Crear
    private string nombre = string.Empty;
    private string? descripcion;

    private string mensaje = string.Empty;

    private bool guardando = false;
    private bool cargando = true;

    // Editar
    private int? materiaEnEdicion;

    private string nombreEdicion = string.Empty;
    private string? descripcionEdicion;

    private bool guardandoEdicion = false;

    // Eliminar
    private int? materiaAEliminar;
    private bool eliminando = false;

    // Temporalmente usamos un usuario existente.
    // Luego será reemplazado por el usuario autenticado.
    private int usuarioId = 4;


    protected override async Task OnInitializedAsync()
    {
        await CargarMaterias();
    }


    private async Task CargarMaterias()
    {
        cargando = true;

        try
        {
            materias = await MateriaService
                .ObtenerMateriasAsync(usuarioId);
        }
        finally
        {
            cargando = false;
        }
    }


    // ============================
    // CREAR
    // ============================

    private async Task CrearMateria()
    {
        if (guardando)
            return;

        if (string.IsNullOrWhiteSpace(nombre))
        {
            mensaje = "El nombre de la materia es obligatorio.";
            return;
        }

        guardando = true;
        mensaje = string.Empty;

        try
        {
            await MateriaService.CrearMateriaAsync(
                nombre.Trim(),
                string.IsNullOrWhiteSpace(descripcion)
                    ? null
                    : descripcion.Trim(),
                usuarioId);

            nombre = string.Empty;
            descripcion = string.Empty;

            mensaje = "Materia creada correctamente.";

            await CargarMaterias();
        }
        finally
        {
            guardando = false;
        }
    }


    // ============================
    // EDITAR
    // ============================

    private void IniciarEdicion(Materia materia)
    {
        materiaEnEdicion = materia.IdMateria;

        nombreEdicion = materia.Nombre;
        descripcionEdicion = materia.Descripcion;
    }


    private void CancelarEdicion()
    {
        materiaEnEdicion = null;

        nombreEdicion = string.Empty;
        descripcionEdicion = string.Empty;
    }


    private async Task GuardarEdicion()
    {
        if (guardandoEdicion)
            return;

        if (materiaEnEdicion == null)
            return;

        if (string.IsNullOrWhiteSpace(nombreEdicion))
            return;

        guardandoEdicion = true;

        try
        {
            bool actualizado =
                await MateriaService.ActualizarMateriaAsync(
                    materiaEnEdicion.Value,
                    nombreEdicion.Trim(),
                    string.IsNullOrWhiteSpace(descripcionEdicion)
                        ? null
                        : descripcionEdicion.Trim(),
                    usuarioId);

            if (actualizado)
            {
                await CargarMaterias();

                CancelarEdicion();
            }
        }
        finally
        {
            guardandoEdicion = false;
        }
    }
    // ============================
// ELIMINAR
// ============================

    private void ConfirmarEliminacion(int idMateria)
    {
        materiaAEliminar = idMateria;
    }

    private void CancelarEliminacion()
    {
        materiaAEliminar = null;
    }

    private async Task EliminarMateria(int idMateria)
    {
        if (eliminando)
            return;

        eliminando = true;

        try
        {
            bool eliminado =
                await MateriaService.EliminarMateriaAsync(
                    idMateria,
                    usuarioId);

            if (eliminado)
            {
                materiaAEliminar = null;

                await CargarMaterias();

                mensaje = "Materia eliminada correctamente.";
            }
        }
        finally
        {
            eliminando = false;
        }
    }
}
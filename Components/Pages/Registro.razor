@using ProyectoBlazor.Models
@using ProyectoBlazor.Services

@inject UsuarioService UsuarioService
@inject UsuarioActualService UsuarioActualService

<h3>Formulario de Registro</h3>

<div class="card p-3 w-50">

    <EditForm Model="@registro"
            OnValidSubmit="RegistrarUsuario"
            FormName="registroUsuario">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="nombre">Nombre</label>

            <InputText id="nombre"
                    class="form-control"
                    @bind-Value="registro.Nombre" />

            <ValidationMessage For="@(() => registro.Nombre)" />
        </div>

        <div class="mb-3">
            <label for="email">Email</label>

            <InputText id="email"
                    type="email"
                    class="form-control"
                    @bind-Value="registro.Email" />

            <ValidationMessage For="@(() => registro.Email)" />
        </div>

        <div class="mb-3">
            <label for="password">Contraseña</label>

            <InputText id="password"
                    type="password"
                    class="form-control"
                    @bind-Value="registro.Password" />

            <ValidationMessage For="@(() => registro.Password)" />
        </div>

        <div class="mb-3">
            <label for="fechaNacimiento">Fecha de nacimiento</label>

            <InputDate id="fechaNacimiento"
                    class="form-control"
                    @bind-Value="registro.FechaNacimiento" />

            <ValidationMessage For="@(() => registro.FechaNacimiento)" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@registrando">

            @(registrando ? "Registrando..." : "Registrarse")

        </button>

    </EditForm>

</div>

<p class="text-success">@mensaje</p>

<!-- Resumen dinámico -->

<div class="card mt-3 shadow-sm">

    <div class="card-header bg-info text-white">
        Resumen en tiempo real
    </div>

    <div class="card-body">

        <p>
            <strong>Nombre:</strong>
            @registro.Nombre
        </p>

        <p>
            <strong>Email:</strong>
            @registro.Email
        </p>

        <p>
            <strong>Fecha de nacimiento:</strong>
            @registro.FechaNacimiento
        </p>

        <p>
            <strong>Contraseña:</strong>
            @(string.IsNullOrEmpty(registro.Password)
                ? ""
                : new string('*', registro.Password.Length))
        </p>

    </div>

</div>

@code {


    private RegistroModel registro = new RegistroModel();

    private string mensaje = string.Empty;

    private bool registrando = false;
    private async Task RegistrarUsuario()
    {
        var usuarioRegistrado =
            await UsuarioService.RegistrarUsuarioAsync(
                registro.Nombre,
                registro.Email,
                registro.Password,
                registro.FechaNacimiento);

        if (usuarioRegistrado != null)
        {
            UsuarioActualService.EstablecerUsuario(
                usuarioRegistrado.IdUsuario);

            mensaje = "Usuario registrado correctamente.";

            registro = new RegistroModel();
        }
        else
        {
            mensaje = "Ya existe un usuario registrado con ese email.";
        }
    }
}
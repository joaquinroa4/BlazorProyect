@page "/registro"

@attribute [Authorize(Roles = "Admin")]

@using ProyectoBlazor.Models
@using ProyectoBlazor.Services

@inject UsuarioService UsuarioService

@rendermode InteractiveServer

<div class="container mt-4 sf-page">

    <div class="sf-page-header">

        <div>

            <span class="sf-eyebrow">Administración</span>

            <h1>Registrar usuario</h1>

            <p>
                Creá una cuenta nueva. El usuario podrá ingresar con el
                email y la contraseña que definas.
            </p>

        </div>

    </div>

    <!-- ====================================================== -->
    <!-- FORMULARIO + RESUMEN -->
    <!-- ====================================================== -->

    <div class="row">

        <!-- ========================== -->
        <!-- FORMULARIO -->
        <!-- ========================== -->

        <div class="col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-header">
                    <h5 class="mb-0">
                        Registrar nuevo usuario
                    </h5>
                </div>

                <div class="card-body">

                    <EditForm Model="@registro"
                            OnValidSubmit="RegistrarUsuario"
                            FormName="registroUsuario">

                        <DataAnnotationsValidator />


                        <div class="mb-3">

                            <label for="nombre">
                                Nombre
                            </label>

                            <InputText id="nombre"
                                    class="form-control"
                                    @bind-Value="registro.Nombre" />

                            <ValidationMessage For="@(() => registro.Nombre)" />

                        </div>


                        <div class="mb-3">

                            <label for="email">
                                Email
                            </label>

                            <InputText id="email"
                                    type="email"
                                    class="form-control"
                                    @bind-Value="registro.Email" />

                            <ValidationMessage For="@(() => registro.Email)" />

                        </div>


                        <div class="mb-3">

                            <label for="password">
                                Contraseña
                            </label>

                            <InputText id="password"
                                    type="password"
                                    class="form-control"
                                    @bind-Value="registro.Password" />

                            <ValidationMessage For="@(() => registro.Password)" />

                        </div>


                        <div class="mb-3">

                            <label for="fechaNacimiento">
                                Fecha de nacimiento
                            </label>

                            <InputDate id="fechaNacimiento"
                                    class="form-control"
                                    @bind-Value="registro.FechaNacimiento" />

                            <ValidationMessage For="@(() => registro.FechaNacimiento)" />

                        </div>


                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@registrando">

                            @(registrando
                                ? "Registrando..."
                                : "Registrarse")

                        </button>

                    </EditForm>


                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert @(registroExitoso ? "alert-success" : "alert-danger") mt-3 mb-0">
                            @mensaje
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ========================== -->
        <!-- RESUMEN EN TIEMPO REAL -->
        <!-- ========================== -->

        <div class="col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-info text-white">

                    <h5 class="mb-0">
                        Resumen en tiempo real
                    </h5>

                </div>

                <div class="card-body">

                    <p>
                        <strong>Nombre:</strong>
                        @registro.Nombre
                    </p>

                    <p>
                        <strong>Email:</strong>
                        @registro.Email
                    </p>

                    <p>
                        <strong>Fecha de nacimiento:</strong>
                        @registro.FechaNacimiento
                    </p>

                    <p>
                        <strong>Contraseña:</strong>

                        @(string.IsNullOrEmpty(registro.Password)
                            ? ""
                            : new string('*', registro.Password.Length))

                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    // ==========================================================
    // REGISTRO
    // ==========================================================

    private RegistroModel registro = new RegistroModel();

    private string mensaje = string.Empty;

    private bool registroExitoso = false;

    private bool registrando = false;


    // ==========================================================
    // REGISTRAR USUARIO
    // ==========================================================

    private async Task RegistrarUsuario()
    {
        if (registrando)
            return;

        registrando = true;
        mensaje = string.Empty;
        registroExitoso = false;

        try
        {
            var usuarioRegistrado =
                await UsuarioService.RegistrarUsuarioAsync(
                    registro.Nombre,
                    registro.Email,
                    registro.Password,
                    registro.FechaNacimiento);

            if (usuarioRegistrado != null)
            {
                registroExitoso = true;

                mensaje = "Usuario registrado correctamente.";

                registro = new RegistroModel();
            }
            else
            {
                mensaje =
                    "Ya existe un usuario registrado con ese email.";
            }
        }
        catch (InvalidOperationException ex)
        {
            // Errores de validación de Identity (por ejemplo,
            // la contraseña no cumple la política).
            mensaje = ex.Message;
        }
        finally
        {
            registrando = false;
        }
    }
}
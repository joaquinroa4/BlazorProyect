@using ProyectoBlazor.Models
@using ProyectoBlazor.Services

@inject UsuarioService UsuarioService
@inject UsuarioActualService UsuarioActualService

<div class="container mt-4">

    <h3>Formulario de Registro de Usuarios</h3>

    <!-- ====================================================== -->
    <!-- FORMULARIO + RESUMEN -->
    <!-- ====================================================== -->

    <div class="row">

        <!-- ========================== -->
        <!-- FORMULARIO -->
        <!-- ========================== -->

        <div class="col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-header">
                    <h5 class="mb-0">
                        Registrar nuevo usuario
                    </h5>
                </div>

                <div class="card-body">

                    <EditForm Model="@registro"
                            OnValidSubmit="RegistrarUsuario"
                            FormName="registroUsuario">

                        <DataAnnotationsValidator />


                        <div class="mb-3">

                            <label for="nombre">
                                Nombre
                            </label>

                            <InputText id="nombre"
                                    class="form-control"
                                    @bind-Value="registro.Nombre" />

                            <ValidationMessage For="@(() => registro.Nombre)" />

                        </div>


                        <div class="mb-3">

                            <label for="email">
                                Email
                            </label>

                            <InputText id="email"
                                    type="email"
                                    class="form-control"
                                    @bind-Value="registro.Email" />

                            <ValidationMessage For="@(() => registro.Email)" />

                        </div>


                        <div class="mb-3">

                            <label for="password">
                                Contraseña
                            </label>

                            <InputText id="password"
                                    type="password"
                                    class="form-control"
                                    @bind-Value="registro.Password" />

                            <ValidationMessage For="@(() => registro.Password)" />

                        </div>


                        <div class="mb-3">

                            <label for="fechaNacimiento">
                                Fecha de nacimiento
                            </label>

                            <InputDate id="fechaNacimiento"
                                    class="form-control"
                                    @bind-Value="registro.FechaNacimiento" />

                            <ValidationMessage For="@(() => registro.FechaNacimiento)" />

                        </div>


                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@registrando">

                            @(registrando
                                ? "Registrando..."
                                : "Registrarse")

                        </button>

                    </EditForm>


                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            @mensaje
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- ========================== -->
        <!-- RESUMEN EN TIEMPO REAL -->
        <!-- ========================== -->

        <div class="col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-header bg-info text-white">

                    <h5 class="mb-0">
                        Resumen en tiempo real
                    </h5>

                </div>

                <div class="card-body">

                    <p>
                        <strong>Nombre:</strong>
                        @registro.Nombre
                    </p>

                    <p>
                        <strong>Email:</strong>
                        @registro.Email
                    </p>

                    <p>
                        <strong>Fecha de nacimiento:</strong>
                        @registro.FechaNacimiento
                    </p>

                    <p>
                        <strong>Contraseña:</strong>

                        @(string.IsNullOrEmpty(registro.Password)
                            ? ""
                            : new string('*', registro.Password.Length))

                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- USUARIOS REGISTRADOS -->
    <!-- ====================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">
                Usuarios registrados
            </h5>

        </div>

        <div class="card-body">

            @if (usuarios.Count == 0)
            {
                <p class="text-muted mb-0">
                    No hay usuarios registrados.
                </p>
            }
            else
            {
<div class="usuarios-grid-container">

    <!-- CABECERA -->

                    <div class="usuarios-grid-header">

                        <div>

                            <h5 class="usuarios-grid-title">
                                Usuarios actualmente registrados en StudyFlow
                            </h5>
                            <div class="usuarios-grid-stats">




                                <span class="usuarios-count">
                                    @usuarios.Count
                                </span>

                                <span class="usuarios-count-label">
                                    @(usuarios.Count == 1
                                        ? "usuario"
                                        : "usuarios")
                                </span>
                            </div>
                        </div>



    </div>


    <!-- TOOLBAR -->

    <div class="usuarios-grid-toolbar">

        <div class="usuarios-search">

            <RadzenIcon Icon="search" />

            <input type="text"
                class="form-control"
                placeholder="Buscar por nombre o email..."
                @bind="textoBusqueda"
                @bind:event="oninput" />

        </div>


        <div class="usuarios-toolbar-actions">

            <button type="button"
                    class="btn btn-outline-primary"
                    @onclick="AlternarFiltros">

                <RadzenIcon Icon="filter_alt" />

                @(mostrarFiltros
                    ? "Ocultar filtros"
                    : "Mostrar filtros")

            </button>


            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="LimpiarBusqueda">

                <RadzenIcon Icon="clear" />

                Limpiar

            </button>

        </div>

    </div>


    <!-- DATAGRID -->

    <RadzenDataGrid @ref="usuariosGrid"
                    Data="@usuariosFiltrados"
                    TItem="Usuario"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="10"
                    PageSizeOptions="@(new int[] { 5, 10, 20, 50 })"
                    AllowFiltering="@mostrarFiltros"
                    FilterMode="FilterMode.Simple"
                    AllowAlternatingRows="true"
                    AllowColumnResize="true"
                    GridLines="DataGridGridLines.Horizontal"
                    ShowPagingSummary="true"
                    PagingSummaryFormat="Mostrando {0} a {1} de {2} usuarios">

        <Columns>

            <RadzenDataGridColumn TItem="Usuario"
                                Property="@nameof(Usuario.IdUsuario)"
                                Title="ID"
                                Width="80px" />

            <RadzenDataGridColumn TItem="Usuario"
                                Property="@nameof(Usuario.Nombre)"
                                Title="Nombre"
                                Width="200px" />

            <RadzenDataGridColumn TItem="Usuario"
                                Property="@nameof(Usuario.Email)"
                                Title="Email"
                                Width="280px" />

            <RadzenDataGridColumn TItem="Usuario"
                                Property="@nameof(Usuario.FechaNacimiento)"
                                Title="Fecha de nacimiento"
                                FormatString="{0:dd/MM/yyyy}"
                                Width="180px" />

            <RadzenDataGridColumn TItem="Usuario"
                                Property="@nameof(Usuario.FechaRegistro)"
                                Title="Fecha de registro"
                                FormatString="{0:dd/MM/yyyy HH:mm}"
                                Width="200px" />

        </Columns>

    </RadzenDataGrid>

            </div>            
            } <!-- Fin Else -->

        </div>

    </div>

</div>


@code {

    // ==========================================================
    // REGISTRO
    // ==========================================================

    private RegistroModel registro = new RegistroModel();

    private string mensaje = string.Empty;

    private bool registrando = false;


    // ==========================================================
    // USUARIOS
    // ==========================================================

    private List<Usuario> usuarios = new();


    // ==========================================================
    // FILTRADO DE USUARIOS
    // ==========================================================

    private string textoBusqueda = string.Empty;

    private IEnumerable<Usuario> usuariosFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? usuarios
            : usuarios.Where(u =>
                u.Nombre.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase)
                ||
                u.Email.Contains(
                    textoBusqueda,
                    StringComparison.OrdinalIgnoreCase));

    private async Task LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;

        if (usuariosGrid != null)
        {
            foreach (var columna in usuariosGrid.ColumnsCollection)
            {
                await usuariosGrid.ClearFilter(
                    columna,
                    closePopup: true,
                    shouldReload: false);
            }

            await usuariosGrid.Reload();
        }
    }

    private bool mostrarFiltros = false;

    private void AlternarFiltros()
    {
        mostrarFiltros = !mostrarFiltros;
    }
    private RadzenDataGrid<Usuario>? usuariosGrid;
    // ==========================================================
    // CARGA INICIAL
    // ==========================================================

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }


    private async Task CargarUsuarios()
    {
        usuarios = await UsuarioService.ObtenerUsuariosAsync();
    }


    // ==========================================================
    // REGISTRAR USUARIO
    // ==========================================================

    private async Task RegistrarUsuario()
    {
        if (registrando)
            return;

        registrando = true;
        mensaje = string.Empty;

        try
        {
            var usuarioRegistrado =
                await UsuarioService.RegistrarUsuarioAsync(
                    registro.Nombre,
                    registro.Email,
                    registro.Password,
                    registro.FechaNacimiento);

            if (usuarioRegistrado != null)
            {
                await UsuarioActualService.EstablecerUsuarioAsync(
                    usuarioRegistrado.IdUsuario);

                mensaje = "Usuario registrado correctamente.";

                registro = new RegistroModel();

                // Actualizamos la lista de usuarios
                await CargarUsuarios();
            }
            else
            {
                mensaje =
                    "Ya existe un usuario registrado con ese email.";
            }
        }
        finally
        {
            registrando = false;
        }
    }

}
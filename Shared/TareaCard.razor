@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using ProyectoBlazor.Models

<div class="card shadow-sm h-100">
    <div style="height: 8px; background-color: #0d6efd; border-radius: 4px 4px 0 0;"></div>

    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Tarea.Titulo</h5>

        @if (!string.IsNullOrWhiteSpace(Tarea.Descripcion))
        {
            <p class="card-text text-muted">@Tarea.Descripcion</p>
        }
        else
        {
            <p class="card-text text-muted">Sin descripción.</p>
        }

        <div class="mt-2">
            <p class="mb-2"><strong>Materia:</strong> @Tarea.Materia?.Nombre</p>
            <p class="mb-2"><strong>Estado:</strong> @Tarea.Estado</p>
            <p class="mb-2"><strong>Prioridad:</strong> @Tarea.Prioridad</p>
            <p class="mb-2"><strong>Dificultad:</strong> @Tarea.Dificultad</p>
            <p class="mb-2">
                <strong>Fecha de entrega:</strong>
                @(Tarea.FechaEntrega?.ToString("dd/MM/yyyy") ?? "Sin fecha")
            </p>
            <p class="mb-0">
                <strong>Tiempo estimado:</strong>
                @(Tarea.TiempoEstimadoMinutos.HasValue
                    ? $"{Tarea.TiempoEstimadoMinutos} minutos"
                    : "Sin estimar")
            </p>
        </div>

        @if (confirmandoEliminacion)
        {
            <div class="mt-auto pt-3">
                <p class="mb-2">¿Eliminar esta tarea?</p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger btn-sm"
                            @onclick="Eliminar" disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm"
                            @onclick="CancelarEliminacion" disabled="@eliminando">
                        Cancelar
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="mt-auto pt-3">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            @onclick="Editar">
                        Editar
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm"
                            @onclick="ConfirmarEliminacion">
                        Eliminar
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Tarea Tarea { get; set; } = null!;

    [Parameter]
    public EventCallback<Tarea> OnEditar { get; set; }

    [Parameter]
    public EventCallback<Tarea> OnEliminar { get; set; }

    private bool confirmandoEliminacion;
    private bool eliminando;

    private Task Editar()
    {
        return OnEditar.InvokeAsync(Tarea);
    }

    private void ConfirmarEliminacion()
    {
        confirmandoEliminacion = true;
    }

    private void CancelarEliminacion()
    {
        confirmandoEliminacion = false;
    }

    private async Task Eliminar()
    {
        if (eliminando)
            return;

        eliminando = true;
        try
        {
            await OnEliminar.InvokeAsync(Tarea);
        }
        finally
        {
            eliminando = false;
        }
    }
}
